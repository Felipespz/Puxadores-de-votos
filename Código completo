{
  eleitos     <- candidatos_todos |> filter(DS_SIT_TOT_TURNO %in% situacoes_eleito)
  nao_eleitos <- candidatos_todos |> filter(!DS_SIT_TOT_TURNO %in% situacoes_eleito)
  
  # I. Eleito menos votado da UF
  ultimo_eleito_uf <- eleitos |>
    group_by(ANO_ELEICAO, SG_UF) |>
