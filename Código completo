  resultados_2018 <- fread(file = "C:/Users/controladoria/Downloads/votacao_candidato_munzona_2018_BRASIL.csv",
                           sep = ";",
                           dec = ",",
                           encoding = "Latin-1")
  resultados_2022 <- fread(file = "C:/Users/controladoria/Downloads/votacao_candidato_munzona_2022_BRASIL.csv",
                           sep = ";",
                           dec = ",",
                           encoding = "Latin-1")
  resultados_2026 <- fread(file = "C:/Users/controladoria/Downloads/votacao_candidato_munzona_2026_BRASIL.csv",
                           sep = ";",
                           dec = ",",
                           encoding = "Latin-1")
  
  # Filtrando apenas deputados federais eleitos
  # Selecionando as variáveis de interesse para identificação da eleição e do parlamentar
  # se estava em coligação ou federação, e quantos votos fez ao todo
  
  resultados_2014_filtrado <- resultados_2014 |>
