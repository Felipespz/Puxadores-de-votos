# Checagem 2: situações não previstas (ex.: problema de encoding em "ELEITO POR MÉDIA")
situacoes_conhecidas <- c(situacoes_eleito, "SUPLENTE", "NÃO ELEITO", "#NULO#", "")
checagem_situacoes <- bind_rows(
  resultados_2014 |> filter(CD_CARGO == 6) |> distinct(ANO_ELEICAO, DS_SIT_TOT_TURNO),
  resultados_2018 |> filter(CD_CARGO == 6) |> distinct(ANO_ELEICAO, DS_SIT_TOT_TURNO),
  resultados_2022 |> filter(CD_CARGO == 6) |> distinct(ANO_ELEICAO, DS_SIT_TOT_TURNO),
  resultados_2026 |> filter(CD_CARGO == 6) |> distinct(ANO_ELEICAO, DS_SIT_TOT_TURNO)
) |>
  filter(!DS_SIT_TOT_TURNO %in% situacoes_conhecidas)
print(checagem_situacoes)

# Checagem 3: nominais do arquivo de candidato x nominais do arquivo de partido, por partido/UF.
# Em 2014 (sem coluna de válidos), diferenças apontam onde há votos anulados ou de
# candidatos #NULO# — é a lista de partidos/UFs para a conferência manual.
# A coluna de nominais do arquivo de partido é escolhida conforme o que existir no arquivo.
nominais_partido_arquivo <- function(df) {
  col <- intersect(c("QT_VOTOS_NOMINAIS_VALIDOS", "QT_VOTOS_NOMINAIS"), names(df))[1]
  df |>
    filter(CD_CARGO == 6) |>
    group_by(ANO_ELEICAO, SG_UF, SG_PARTIDO) |>
    summarise(NOMINAIS_ARQ_PARTIDO = sum(.data[[col]], na.rm = TRUE), .groups = "drop")
}
checagem_nominais <- bind_rows(
  nominais_partido_arquivo(resultados_2014_partido),
  nominais_partido_arquivo(resultados_2018_partido),
  nominais_partido_arquivo(resultados_2022_partido),
  nominais_partido_arquivo(resultados_2026_partido)
) |>
  full_join(
    candidatos_todos |>
      group_by(ANO_ELEICAO, SG_UF, SG_PARTIDO) |>
      summarise(NOMINAIS_ARQ_CANDIDATO = sum(VOTOS_NOMINAIS_CANDIDATO), .groups = "drop"),
    by = c("ANO_ELEICAO", "SG_UF", "SG_PARTIDO")
  ) |>
  mutate(DIFERENCA = coalesce(NOMINAIS_ARQ_CANDIDATO, 0) - coalesce(NOMINAIS_ARQ_PARTIDO, 0)) |>
  filter(DIFERENCA != 0) |>
  arrange(ANO_ELEICAO, desc(abs(DIFERENCA)))
print(checagem_nominais)

# Checagem 4: cada AGRUPAMENTO_ID corresponde a um único nome (e vice-versa) dentro da UF?
checagem_agrupamento <- candidatos_todos |>
  distinct(ANO_ELEICAO, SG_UF, AGRUPAMENTO_ID, AGRUPAMENTO_ELEITORAL) |>
  group_by(ANO_ELEICAO, SG_UF) |>
  filter(duplicated(AGRUPAMENTO_ID) | duplicated(AGRUPAMENTO_ELEITORAL)) |>
  ungroup()
print(checagem_agrupamento)

